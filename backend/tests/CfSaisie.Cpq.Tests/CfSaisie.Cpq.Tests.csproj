<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CfSaisie.Cpq\CfSaisie.Cpq.csproj" />
    <Reference Include="SmartDataExchangeDefines">
      <HintPath>..\..\lib\SmartDataExchangeDefines.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Requêtes JSON de référence (format exact) et requêtes attendues (règles métier) -->
    <None Include="Reference\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Attendu\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
